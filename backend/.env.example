# Copy this file to `.env` and fill in the values.
#   cp .env.example .env

# Runtime
NODE_ENV=development
PORT=8000

# MongoDB connection string used by Prisma
# e.g. mongodb+srv://<user>:<password>@<cluster>/<db>
DATABASE_URL=

# JWT
ACCESS_TOKEN_SECRET=
# Accepts a duration string such as: 30m, 1h, 7d, 2w
ACCESS_TOKEN_SECRET_EXPIRES_IN=7d

# Allowed browser origins (CORS + Socket.IO)
CLIENT_DEVELOPMENT_DOMAIN=http://localhost:3000
CLIENT_PRODUCTION_DOMAIN=

# Cloudinary (profile pictures & message attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer / Gmail)
EMAIL_ADDRESS=
EMAIL_PASSWORD=
